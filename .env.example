# Copy to .env and fill in. Never commit .env.

# Claude API (optional, for news/email summaries) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Interactive Brokers Flex Web Service (see README)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_NET_DEPOSITS=

# Calendly personal access token (Integrations > API & Webhooks)
CALENDLY_TOKEN=

# Gmail: use an App Password, not your normal password
GMAIL_USER=
GMAIL_APP_PASSWORD=
