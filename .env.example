# Copy to .env and fill in. Never commit .env.
# Accounts (email, Calendly, calendars, channels, podcasts, AI key) are added in the
# app's Settings page. This file only holds the few things that need a restart.

# Set a password to open the dashboard from your phone or another computer.
# With a password set, the dashboard listens on your network (HOST=0.0.0.0).
DASHBOARD_PASSWORD=

# Optional: AI summaries via config.yaml instead of Settings.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Interactive Brokers Flex Web Service (see README)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_NET_DEPOSITS=
